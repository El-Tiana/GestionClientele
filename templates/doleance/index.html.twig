{% extends 'base.html.twig' %}

{% block title %}Doleance index{% endblock %}

{% block body %}
    <h1>Doleance index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Plainte</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for doleance in doleances %}
            <tr>
                <td>{{ doleance.id }}</td>
                <td>{{ doleance.plainte }}</td>
                <td>
                    <a href="{{ path('doleance_show', {'id': doleance.id}) }}">show</a>
                    <a href="{{ path('doleance_edit', {'id': doleance.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('doleance_new') }}">Create new</a>
{% endblock %}
